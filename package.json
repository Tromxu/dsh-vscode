{
  "name": "dsh-vscode",
  "displayName": "DeepSeek Harness (DSH) Agent",
  "description": "原生 VS Code 智能体：侧边栏聊天驱动 DSH 运行时，文件修改实时反映到编辑器，命令执行可见于集成终端，权限请求用原生对话框。",
  "version": "0.7.0",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onView:dsh.chatView",
    "onCommand:dsh.openChat",
    "onCommand:dsh.setApiKey",
    "onCommand:dsh.fullPipeline",
    "onCommand:dsh.setWorkspace",
    "onCommand:dsh.openWorkspace",
    "onCommand:dsh.openHistory",
    "onCommand:dsh.openPanel",
    "onCommand:dsh.quickTask",
    "onCommand:dsh.stop",
    "onCommand:dsh.openLog"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh",
          "title": "DSH Agent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dsh": [
        {
          "id": "dsh.chatView",
          "name": "会话",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "dsh.openChat",
        "title": "DSH: 打开智能体会话",
        "category": "DSH"
      },
      {
        "command": "dsh.setApiKey",
        "title": "DSH: 配置 DeepSeek API Key",
        "category": "DSH"
      },
      {
        "command": "dsh.fullPipeline",
        "title": "DSH: 全流程开发（产品→发布）",
        "category": "DSH"
      },
      {
        "command": "dsh.setWorkspace",
        "title": "DSH: 设置工程位置…",
        "category": "DSH"
      },
      {
        "command": "dsh.openWorkspace",
        "title": "DSH: 打开工程位置",
        "category": "DSH"
      },
      {
        "command": "dsh.openHistory",
        "title": "DSH: 打开历史工程/会话…",
        "category": "DSH"
      },
      {
        "command": "dsh.openPanel",
        "title": "DSH: 打开 Web 面板（旧版）",
        "category": "DSH"
      },
      {
        "command": "dsh.quickTask",
        "title": "DSH: 快速任务（无头模式）",
        "category": "DSH"
      },
      {
        "command": "dsh.stop",
        "title": "DSH: 停止运行时",
        "category": "DSH"
      },
      {
        "command": "dsh.openLog",
        "title": "DSH: 查看运行日志",
        "category": "DSH"
      }
    ],
    "configuration": {
      "title": "DSH Agent",
      "properties": {
        "dsh.harnessRoot": {
          "type": "string",
          "default": "",
          "description": "DeepSeek Harness 安装目录。留空 = 自动探测（环境变量 DSH_HARNESS → 各平台标准安装位置）；找不到时请手动填写。"
        },
        "dsh.nodePath": {
          "type": "string",
          "default": "",
          "description": "可选：捆绑 node.exe 的路径；留空时自动使用 harnessRoot\\resources\\node\\node.exe。"
        },
        "dsh.dshHome": {
          "type": "string",
          "default": "",
          "description": "DSH_HOME 数据目录。留空 = 插件私有目录（推荐）；如需复用桌面版配置可填其 dsh-home 路径（使用前先关闭桌面版）。"
        },
        "dsh.workspaceRoot": {
          "type": "string",
          "default": "",
          "description": "工程存储位置（智能体工作目录）。留空 = 使用 VS Code 当前打开的文件夹；也可用命令「DSH: 设置工程位置…」选择。"
        },
        "dsh.port": {
          "type": "number",
          "default": 0,
          "description": "Web 服务端口；0 = 自动分配空闲端口。"
        },
        "dsh.bootTimeoutSec": {
          "type": "number",
          "default": 120,
          "description": "运行时启动超时（秒）。"
        },
        "dsh.autoOpen": {
          "type": "boolean",
          "default": false,
          "description": "VS Code 启动后自动打开智能体会话视图。"
        },
        "dsh.approveCommands": {
          "type": "boolean",
          "default": true,
          "description": "命令执行前是否弹原生确认框（关掉则自动放行命令，有风险）。"
        }
      }
    },
    "keybindings": [
      {
        "command": "dsh.openHistory",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "title": "DSH: 打开历史工程/会话…"
      },
      {
        "command": "dsh.fullPipeline",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "title": "DSH: 全流程开发（产品→发布）"
      },
      {
        "command": "dsh.setWorkspace",
        "key": "ctrl+alt+w",
        "mac": "cmd+alt+w",
        "title": "DSH: 设置工程位置…"
      },
      {
        "command": "dsh.setApiKey",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "title": "DSH: 配置 DeepSeek API Key"
      },
      {
        "command": "dsh.stop",
        "key": "ctrl+alt+x",
        "mac": "cmd+alt+x",
        "title": "DSH: 停止运行时"
      }
    ]
  },
  "scripts": {
    "package:vsix": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
